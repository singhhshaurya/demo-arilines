# ========================================
# SkyPulse Demo - Environment Variables
# Copy this file to .env and fill values
# ========================================

# MongoDB - full connection URI
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/
# For local: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://MONGODB_USERNAME:MONGODB_PASSWORD@your-cluster.mongodb.net/

# Google OAuth (from Google Cloud Console)
GOOGLE_AUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your_google_client_secret

# Razorpay (test/sandbox keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Panel Password (simple string for demo)
ADMIN_PASSWORD=admin123

# JWT Secret (any random string)
JWT_SECRET=skypulse_jwt_secret_change_me

# Admin email (optional - this email gets admin role on Google login)
ADMIN_EMAIL=your_admin_email@gmail.com
