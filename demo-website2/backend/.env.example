# SkyPulse Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# Server Configuration
PORT=9000
FLASK_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/skypulse_db

# Google OAuth 2.0 Credentials
GOOGLE_AUTH_CLIENT_ID=your_google_auth_client_id_here.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your_google_auth_client_secret_here

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_yourkeyidhere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Admin Access Credentials
ADMIN_PASSWORD=admin_secret_password_123
ADMIN_EMAIL=admin@skypulse.com

# JWT Secret for Session Authentication
JWT_SECRET=skypulse_super_secret_jwt_key_change_in_production_2026
